FDT_DATABASE_URL=postgresql+psycopg://fdt:fdt@localhost:5432/fdt
FDT_JWT_SECRET=change-me-to-a-long-random-string
FDT_CORS_ORIGINS=http://localhost:5173
FDT_DEMO_MODE=true
FDT_DEMO_TICK_SECONDS=1.2
FDT_RUL_CAP=125
# Do NOT set FDT_ML_MODEL_PATH / FDT_ML_CONTRACT_PATH here. Leaving them unset lets
# ml_variant resolve the artifact set that actually exists (see app/core/config.py):
#
#   FDT_ML_VARIANT=full     -> data/ml/full/xgboost_fd001_full.json        (100 engines)
#                              data/ml/full/feature_contract_fd001_full.json
#                              data/ml/full/regime_baselines_fd001.json    (named by contract)
#   FDT_ML_VARIANT=holdout  -> data/ml/holdout/xgboost_fd001_rul.json      (80 engines)
#                              data/ml/holdout/feature_contract.json
#                              data/ml/holdout/scaler_fd001.pkl
#
# An explicit path here OVERRIDES the variant, so a stale one silently points the
# loader at a file that does not exist and the app falls back to rul = 125 - cycle.
# That is exactly what happened with the old models_artifacts/rul_xgb.json default.
FDT_ML_VARIANT=full
FDT_ML_FALLBACK=true
FDT_DATA_DIR=data
