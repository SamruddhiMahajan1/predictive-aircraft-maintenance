{
  "name": "fleet-digital-twin-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fleet Digital Twin operations console: 3D aircraft inspector, health dashboard and maintenance plan.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run compress",
    "compress": "node scripts/compress-dist.mjs",
    "preview": "vite preview --port 4173",
    "test": "node --test src/state/__tests__/*.test.js",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "vite": "^8.3.4",
    "vite-plugin-string": "^1.2.3"
  }
}
